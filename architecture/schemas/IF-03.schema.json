{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "namma-space/IF-03.schema.json",
 "title": "IF-03 \u2014 Scene (appearance) artifact metadata",
 "type": "object",
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "timestamp": {
   "type": "string",
   "format": "date-time"
  },
  "vec3": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "vec2": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "polygon2": {
   "description": "Closed ring in site-frame X\u2013Z metres (first point need not repeat).",
   "type": "array",
   "items": {
    "$ref": "#/$defs/vec2"
   },
   "minItems": 3
  },
  "transform": {
   "description": "Row-major 4x4 homogeneous transform mapping the artifact frame INTO the site frame (right-handed, metres, +Y up). Scale is carried inside the matrix.",
   "type": "object",
   "required": [
    "matrix_row_major",
    "source",
    "method"
   ],
   "properties": {
    "matrix_row_major": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 16,
     "maxItems": 16
    },
    "source": {
     "enum": [
      "identity",
      "capture_vio",
      "sfm_alignment",
      "tape_scale",
      "manual_alignment",
      "external"
     ]
    },
    "method": {
     "type": "string"
    },
    "residual_m": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "provenance": {
   "description": "Where a datum came from. Human-corrected or externally supplied data must say so.",
   "type": "object",
   "required": [
    "origin",
    "method",
    "created_at"
   ],
   "properties": {
    "origin": {
     "enum": [
      "automatic",
      "human_corrected",
      "human_authored",
      "external",
      "synthetic_fixture"
     ]
    },
    "method": {
     "type": "string"
    },
    "tool": {
     "type": "string"
    },
    "tool_version": {
     "type": "string"
    },
    "author_role": {
     "enum": [
      "CAP",
      "REC",
      "NAV",
      "WEB",
      "LEAD",
      "SCRIPT"
     ]
    },
    "created_at": {
     "$ref": "#/$defs/timestamp"
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "site_frame": {
   "description": "Site frame declaration (ARCH-002).",
   "type": "object",
   "required": [
    "frame_id",
    "units",
    "handedness",
    "up_axis",
    "datum"
   ],
   "properties": {
    "frame_id": {
     "type": "string"
    },
    "units": {
     "const": "m"
    },
    "handedness": {
     "const": "right"
    },
    "up_axis": {
     "const": "+Y"
    },
    "datum": {
     "type": "string",
     "description": "Physical description of the origin mark and +X reference."
    }
   },
   "additionalProperties": false
  }
 },
 "required": [
  "contract",
  "contract_version",
  "scene_id",
  "run_id",
  "representation",
  "assets",
  "to_site",
  "site_frame",
  "provenance"
 ],
 "properties": {
  "scene_id": {
   "type": "string"
  },
  "run_id": {
   "type": "string"
  },
  "representation": {
   "enum": [
    "gaussian_splat",
    "textured_mesh",
    "point_cloud"
   ]
  },
  "assets": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "path",
     "format",
     "sha256",
     "bytes"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "format": {
      "enum": [
       "ply",
       "spz",
       "sog",
       "splat",
       "ksplat",
       "glb",
       "gltf"
      ]
     },
     "sha256": {
      "$ref": "#/$defs/sha256"
     },
     "bytes": {
      "type": "integer",
      "minimum": 1
     },
     "lod_level": {
      "type": "integer",
      "minimum": 0
     },
     "gaussian_count": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0
     }
    },
    "additionalProperties": false
   }
  },
  "to_site": {
   "$ref": "#/$defs/transform",
   "description": "ARCH-020: asset payload coordinates are in the artifact frame; the consumer applies to_site to them exactly once."
  },
  "site_frame": {
   "$ref": "#/$defs/site_frame"
  },
  "bounds_site": {
   "type": "object",
   "required": [
    "min",
    "max"
   ],
   "properties": {
    "min": {
     "$ref": "#/$defs/vec3"
    },
    "max": {
     "$ref": "#/$defs/vec3"
    }
   },
   "additionalProperties": false
  },
  "is_test_asset": {
   "type": "boolean",
   "description": "True for any asset not reconstructed from this run's capture."
  },
  "provenance": {
   "$ref": "#/$defs/provenance"
  },
  "contract": {
   "const": "IF-03"
  },
  "contract_version": {
   "type": "string",
   "pattern": "^1\\.\\d+\\.\\d+$"
  }
 },
 "additionalProperties": false
}