{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "namma-space/IF-11.schema.json",
 "title": "IF-11 \u2014 Release manifest",
 "type": "object",
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "timestamp": {
   "type": "string",
   "format": "date-time"
  },
  "vec3": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "vec2": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "polygon2": {
   "description": "Closed ring in site-frame X\u2013Z metres (first point need not repeat).",
   "type": "array",
   "items": {
    "$ref": "#/$defs/vec2"
   },
   "minItems": 3
  },
  "transform": {
   "description": "Row-major 4x4 homogeneous transform mapping the artifact frame INTO the site frame (right-handed, metres, +Y up). Scale is carried inside the matrix.",
   "type": "object",
   "required": [
    "matrix_row_major",
    "source",
    "method"
   ],
   "properties": {
    "matrix_row_major": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 16,
     "maxItems": 16
    },
    "source": {
     "enum": [
      "identity",
      "capture_vio",
      "sfm_alignment",
      "tape_scale",
      "manual_alignment",
      "external"
     ]
    },
    "method": {
     "type": "string"
    },
    "residual_m": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "provenance": {
   "description": "Where a datum came from. Human-corrected or externally supplied data must say so.",
   "type": "object",
   "required": [
    "origin",
    "method",
    "created_at"
   ],
   "properties": {
    "origin": {
     "enum": [
      "automatic",
      "human_corrected",
      "human_authored",
      "external",
      "synthetic_fixture"
     ]
    },
    "method": {
     "type": "string"
    },
    "tool": {
     "type": "string"
    },
    "tool_version": {
     "type": "string"
    },
    "author_role": {
     "enum": [
      "CAP",
      "REC",
      "NAV",
      "WEB",
      "LEAD",
      "SCRIPT"
     ]
    },
    "created_at": {
     "$ref": "#/$defs/timestamp"
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "site_frame": {
   "description": "Site frame declaration (ARCH-002).",
   "type": "object",
   "required": [
    "frame_id",
    "units",
    "handedness",
    "up_axis",
    "datum"
   ],
   "properties": {
    "frame_id": {
     "type": "string"
    },
    "units": {
     "const": "m"
    },
    "handedness": {
     "const": "right"
    },
    "up_axis": {
     "const": "+Y"
    },
    "datum": {
     "type": "string",
     "description": "Physical description of the origin mark and +X reference."
    }
   },
   "additionalProperties": false
  }
 },
 "required": [
  "contract",
  "contract_version",
  "release_id",
  "built_at",
  "artifacts",
  "regression"
 ],
 "properties": {
  "release_id": {
   "type": "string"
  },
  "git_tag": {
   "type": "string"
  },
  "git_commit": {
   "type": "string",
   "pattern": "^[0-9a-f]{7,40}$"
  },
  "built_at": {
   "$ref": "#/$defs/timestamp"
  },
  "artifacts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "path",
     "sha256",
     "bytes"
    ],
    "properties": {
     "path": {
      "type": "string"
     },
     "sha256": {
      "$ref": "#/$defs/sha256"
     },
     "bytes": {
      "type": "integer",
      "minimum": 1
     }
    },
    "additionalProperties": false
   }
  },
  "regression": {
   "type": "object",
   "required": [
    "passed",
    "suite_version"
   ],
   "properties": {
    "passed": {
     "type": "boolean"
    },
    "suite_version": {
     "type": "string"
    },
    "failures": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "command": {
     "type": "string",
     "description": "2.0.0"
    },
    "log_path": {
     "type": "string",
     "description": "2.0.0"
    },
    "log_sha256": {
     "$ref": "#/$defs/sha256",
     "description": "2.0.0"
    }
   },
   "additionalProperties": false
  },
  "deploy_targets": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "previous_release_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "source": {
   "description": "2.0.0 (ARCH-022): build identity. vcs='none' means no version-control commit exists; tree_sha256 identifies the exact artifact set.",
   "type": "object",
   "required": [
    "vcs",
    "tree_sha256"
   ],
   "properties": {
    "vcs": {
     "enum": [
      "git",
      "none"
     ]
    },
    "git_tag": {
     "type": "string"
    },
    "git_commit": {
     "type": "string",
     "pattern": "^[0-9a-f]{7,40}$"
    },
    "tree_sha256": {
     "$ref": "#/$defs/sha256"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "vcs": {
        "const": "git"
       }
      }
     },
     "then": {
      "required": [
       "git_tag",
       "git_commit"
      ]
     }
    }
   ],
   "additionalProperties": false
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "2.0.0"
  },
  "contract": {
   "const": "IF-11"
  },
  "contract_version": {
   "type": "string",
   "pattern": "^[12]\\.\\d+\\.\\d+$"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "contract_version": {
      "pattern": "^1\\."
     }
    }
   },
   "then": {
    "required": [
     "git_tag",
     "git_commit"
    ],
    "not": {
     "anyOf": [
      {
       "required": [
        "source"
       ]
      },
      {
       "required": [
        "notes"
       ]
      }
     ]
    }
   }
  },
  {
   "if": {
    "properties": {
     "contract_version": {
      "pattern": "^2\\."
     }
    }
   },
   "then": {
    "required": [
     "source"
    ],
    "not": {
     "anyOf": [
      {
       "required": [
        "git_tag"
       ]
      },
      {
       "required": [
        "git_commit"
       ]
      }
     ]
    }
   }
  }
 ],
 "additionalProperties": false
}