{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "namma-space/IF-02.schema.json",
 "title": "IF-02 \u2014 Reconstruction job spec and status (adapter boundary)",
 "type": "object",
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "timestamp": {
   "type": "string",
   "format": "date-time"
  },
  "vec3": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "vec2": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "polygon2": {
   "description": "Closed ring in site-frame X\u2013Z metres (first point need not repeat).",
   "type": "array",
   "items": {
    "$ref": "#/$defs/vec2"
   },
   "minItems": 3
  },
  "transform": {
   "description": "Row-major 4x4 homogeneous transform mapping the artifact frame INTO the site frame (right-handed, metres, +Y up). Scale is carried inside the matrix.",
   "type": "object",
   "required": [
    "matrix_row_major",
    "source",
    "method"
   ],
   "properties": {
    "matrix_row_major": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 16,
     "maxItems": 16
    },
    "source": {
     "enum": [
      "identity",
      "capture_vio",
      "sfm_alignment",
      "tape_scale",
      "manual_alignment",
      "external"
     ]
    },
    "method": {
     "type": "string"
    },
    "residual_m": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "provenance": {
   "description": "Where a datum came from. Human-corrected or externally supplied data must say so.",
   "type": "object",
   "required": [
    "origin",
    "method",
    "created_at"
   ],
   "properties": {
    "origin": {
     "enum": [
      "automatic",
      "human_corrected",
      "human_authored",
      "external",
      "synthetic_fixture"
     ]
    },
    "method": {
     "type": "string"
    },
    "tool": {
     "type": "string"
    },
    "tool_version": {
     "type": "string"
    },
    "author_role": {
     "enum": [
      "CAP",
      "REC",
      "NAV",
      "WEB",
      "LEAD",
      "SCRIPT"
     ]
    },
    "created_at": {
     "$ref": "#/$defs/timestamp"
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "site_frame": {
   "description": "Site frame declaration (ARCH-002).",
   "type": "object",
   "required": [
    "frame_id",
    "units",
    "handedness",
    "up_axis",
    "datum"
   ],
   "properties": {
    "frame_id": {
     "type": "string"
    },
    "units": {
     "const": "m"
    },
    "handedness": {
     "const": "right"
    },
    "up_axis": {
     "const": "+Y"
    },
    "datum": {
     "type": "string",
     "description": "Physical description of the origin mark and +X reference."
    }
   },
   "additionalProperties": false
  }
 },
 "required": [
  "contract",
  "contract_version",
  "job_id",
  "run_id",
  "adapter",
  "inputs",
  "status",
  "timebox_s"
 ],
 "properties": {
  "job_id": {
   "type": "string"
  },
  "run_id": {
   "type": "string"
  },
  "adapter": {
   "type": "object",
   "required": [
    "name",
    "version",
    "concept"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "concept": {
     "enum": [
      "CON-01",
      "CON-02",
      "CON-03",
      "CON-04",
      "test-fixture"
     ]
    }
   },
   "additionalProperties": false
  },
  "inputs": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "timebox_s": {
   "type": "integer",
   "minimum": 1
  },
  "status": {
   "enum": [
    "queued",
    "running",
    "succeeded",
    "failed",
    "timed_out",
    "cancelled"
   ]
  },
  "started_at": {
   "$ref": "#/$defs/timestamp"
  },
  "ended_at": {
   "$ref": "#/$defs/timestamp"
  },
  "outputs": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Paths to IF-03 and IF-04 artifacts produced."
  },
  "error": {
   "type": [
    "string",
    "null"
   ]
  },
  "contract": {
   "const": "IF-02"
  },
  "contract_version": {
   "type": "string",
   "pattern": "^1\\.\\d+\\.\\d+$"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "status": {
      "const": "succeeded"
     }
    }
   },
   "then": {
    "required": [
     "outputs"
    ],
    "properties": {
     "outputs": {
      "minItems": 1
     }
    }
   }
  }
 ],
 "additionalProperties": false
}