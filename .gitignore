phase13_artifacts/projects/
phase13_artifacts/browser/**/*.png
phase12_artifacts/exp015_openmvs_kicker_run1/
phase12_artifacts/exp014_colmap_kicker_run*/database.db*
runs/
dist/
releases/
test_output/

